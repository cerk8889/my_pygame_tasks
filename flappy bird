import pygame
import random
import sys

# Инициализация Pygame
pygame.init()

# Константы
WIDTH = 400
HEIGHT = 600
GRAVITY = 0.5
JUMP_STRENGTH = -10
PIPE_WIDTH = 80
PIPE_GAP = 200
PIPE_VELOCITY = -4
BIRD_SIZE = 30

# Цвета
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GREEN = (0, 255, 0)
YELLOW = (255, 255, 0)
BLUE = (135, 206, 235)
BROWN = (139, 69, 19)
RED = (255, 0, 0)

class Bird:
    """Класс птички"""
    
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.velocity = 0
        self.size = BIRD_SIZE
        
    def jump(self):
        """Прыжок птички"""
        self.velocity = JUMP_STRENGTH
        
    def update(self):
        """Обновление позиции птички"""
        self.velocity += GRAVITY
        self.y += self.velocity
        
    def draw(self, screen):
        """Отрисовка птички"""
        pygame.draw.circle(screen, YELLOW, (int(self.x), int(self.y)), self.size // 2)
        pygame.draw.circle(screen, BLACK, (int(self.x) + 10, int(self.y) - 5), 3)  # Глаз
        
    def get_rect(self):
        """Получение прямоугольника для коллизий"""
        return pygame.Rect(self.x - self.size//2, self.y - self.size//2, self.size, self.size)

class Pipe:
    """Класс трубы"""
    
    def __init__(self, x):
        self.x = x
        self.height = random.randint(100, HEIGHT - PIPE_GAP - 100)
        self.passed = False
        
    def update(self):
        """Обновление позиции трубы"""
        self.x += PIPE_VELOCITY
        
    def draw(self, screen):
        """Отрисовка трубы"""
        # Верхняя труба
        pygame.draw.rect(screen, GREEN, (self.x, 0, PIPE_WIDTH, self.height))
        pygame.draw.rect(screen, BROWN, (self.x - 10, self.height - 50, PIPE_WIDTH + 20, 50))
        
        # Нижняя труба
        bottom_y = self.height + PIPE_GAP
        pygame.draw.rect(screen, GREEN, (self.x, bottom_y, PIPE_WIDTH, HEIGHT - bottom_y))
        pygame.draw.rect(screen, BROWN, (self.x - 10, bottom_y, PIPE_WIDTH + 20, 50))
        
    def get_rects(self):
        """Получение прямоугольников для коллизий"""
        top_rect = pygame.Rect(self.x, 0, PIPE_WIDTH, self.height)
        bottom_rect = pygame.Rect(self.x, self.height + PIPE_GAP, PIPE_WIDTH, HEIGHT - self.height - PIPE_GAP)
        return top_rect, bottom_rect
    
    def is_offscreen(self):
        """Проверка, ушла ли труба за экран"""
        return self.x + PIPE_WIDTH < 0

class Game:
    """Основной класс игры"""
    
    def __init__(self):
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT))
        pygame.display.set_caption("Flappy Bird")
        self.clock = pygame.time.Clock()
        self.font_large = pygame.font.Font(None, 72)
        self.font_small = pygame.font.Font(None, 36)
        self.reset_game()
        
    def reset_game(self):
        """Сброс игры"""
        self.bird = Bird(WIDTH // 3, HEIGHT // 2)
        self.pipes = []
        self.score = 0
        self.game_over = False
        self.game_started = False
        self.frame_count = 0
        
        # Создаём первые трубы
        self.add_pipe()
        
    def add_pipe(self):
        """Добавление новой трубы"""
        self.pipes.append(Pipe(WIDTH))
        
    def handle_events(self):
        """Обработка событий"""
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
                
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE or event.key == pygame.K_UP:
                    if not self.game_started:
                        self.game_started = True
                    if not self.game_over:
                        self.bird.jump()
                        
                if event.key == pygame.K_r and self.game_over:
                    self.reset_game()
                    
                if event.key == pygame.K_ESCAPE:
                    return False
                    
        return True
        
    def update(self):
        """Обновление игровой логики"""
        if not self.game_started or self.game_over:
            return
            
        # Обновляем птичку
        self.bird.update()
        
        # Обновляем трубы
        for pipe in self.pipes[:]:
            pipe.update()
            if pipe.is_offscreen():
                self.pipes.remove(pipe)
                
        # Добавляем новые трубы
        self.frame_count += 1
        if self.frame_count > 90:  # Каждые 90 кадров (около 1.5 секунд)
            self.add_pipe()
            self.frame_count = 0
            
        # Проверка коллизий
        bird_rect = self.bird.get_rect()
        
        # Столкновение с границами экрана
        if bird_rect.top <= 0 or bird_rect.bottom >= HEIGHT:
            self.game_over = True
            
        # Столкновение с трубами
        for pipe in self.pipes:
            top_rect, bottom_rect = pipe.get_rects()
            if bird_rect.colliderect(top_rect) or bird_rect.colliderect(bottom_rect):
                self.game_over = True
                
            # Подсчёт очков
            if not pipe.passed and pipe.x + PIPE_WIDTH < self.bird.x:
                pipe.passed = True
                self.score += 1
                
    def draw(self):
        """Отрисовка игры"""
        # Небо
        self.screen.fill(BLUE)
        
        # Облака (декорация)
        for i in range(3):
            cloud_x = (self.frame_count * 0.5 + i * 150) % (WIDTH + 100) - 50
            pygame.draw.ellipse(self.screen, WHITE, (cloud_x, 80, 60, 40))
            pygame.draw.ellipse(self.screen, WHITE, (cloud_x + 30, 70, 50, 35))
            pygame.draw.ellipse(self.screen, WHITE, (cloud_x + 60, 80, 55, 38))
        
        # Трубы
        for pipe in self.pipes:
            pipe.draw(self.screen)
            
        # Птичка
        self.bird.draw(self.screen)
        
        # Земля
        pygame.draw.rect(self.screen, BROWN, (0, HEIGHT - 20, WIDTH, 20))
        
        # Счёт
        score_text = self.font_large.render(str(self.score), True, WHITE)
        score_shadow = self.font_large.render(str(self.score), True, BLACK)
        self.screen.blit(score_shadow, (WIDTH//2 - 20 + 3, 48 + 3))
        self.screen.blit(score_text, (WIDTH//2 - 20, 50))
        
        # Сообщения
        if not self.game_started:
            start_text = self.font_small.render("Нажми ПРОБЕЛ или СТРЕЛКУ ВВЕРХ", True, WHITE)
            start_shadow = self.font_small.render("Нажми ПРОБЕЛ или СТРЕЛКУ ВВЕРХ", True, BLACK)
            self.screen.blit(start_shadow, (WIDTH//2 - start_text.get_width()//2 + 2, HEIGHT//2 - 50 + 2))
            self.screen.blit(start_text, (WIDTH//2 - start_text.get_width()//2, HEIGHT//2 - 50))
            
            help_text = self.font_small.render("Чтобы начать игру!", True, WHITE)
            help_shadow = self.font_small.render("Чтобы начать игру!", True, BLACK)
            self.screen.blit(help_shadow, (WIDTH//2 - help_text.get_width()//2 + 2, HEIGHT//2 - 20 + 2))
            self.screen.blit(help_text, (WIDTH//2 - help_text.get_width()//2, HEIGHT//2 - 20))
            
        elif self.game_over:
            game_over_text = self.font_large.render("GAME OVER", True, RED)
            game_over_shadow = self.font_large.render("GAME OVER", True, BLACK)
            self.screen.blit(game_over_shadow, (WIDTH//2 - game_over_text.get_width()//2 + 3, HEIGHT//2 - 60 + 3))
            self.screen.blit(game_over_text, (WIDTH//2 - game_over_text.get_width()//2, HEIGHT//2 - 60))
            
            score_text_end = self.font_small.render(f"Твой счёт: {self.score}", True, WHITE)
            self.screen.blit(score_text_end, (WIDTH//2 - score_text_end.get_width()//2, HEIGHT//2))
            
            restart_text = self.font_small.render("Нажми R, чтобы сыграть снова", True, WHITE)
            self.screen.blit(restart_text, (WIDTH//2 - restart_text.get_width()//2, HEIGHT//2 + 50))
            
        pygame.display.flip()
        
    def run(self):
        """Главный цикл игры"""
        running = True
        
        while running:
            running = self.handle_events()
            self.update()
            self.draw()
            self.clock.tick(60)  # 60 FPS
            
        pygame.quit()
        sys.exit()

# Запуск игры
if __name__ == "__main__":
    game = Game()
    game.run()
